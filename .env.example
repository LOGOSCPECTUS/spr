PORT=3000

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Single-tenant fallback: account id to attribute failed payments to when a
# webhook has no connected-account (non-Connect setups). Leave blank for Connect.
DEFAULT_ACCOUNT_ID=

# Resend
RESEND_API_KEY=
# Verified sender address (defaults to Resend's test address if unset).
RESEND_FROM_EMAIL=

# Anthropic (Claude) — AI campaign generator. If unset, generation falls back
# to the deterministic template.
ANTHROPIC_API_KEY=

# Shared secret for the cron trigger endpoint (x-cron-secret header).
CRON_SECRET=

# Shared secret for the outreach trigger endpoint. Passed as
# `Authorization: Bearer <secret>` or the `x-outreach-secret` header.
# Falls back to CRON_SECRET when unset.
OUTREACH_SECRET=
